<idea-plugin package="com.intellij.kotlin.jupyter.k2">

    <dependencies>
        <plugin id="com.intellij.modules.kotlin.k2"/>
        <module name="intellij.kotlin.jupyter.core"/>
        <module name="intellij.notebooks.jupyter.core"/>
        <module name="intellij.jupyter.core"/>
    </dependencies>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <scriptDefinitionsSource implementation="com.intellij.kotlin.jupyter.k2.scriptingSupport.KotlinNotebookScriptDefinitionsSource"/>
        <scriptConfigurationsSource implementation="com.intellij.kotlin.jupyter.k2.scriptingSupport.NotebookScriptConfigurationsSource"/>
        <scriptAdditionalIdeaDependenciesProvider implementation="com.intellij.kotlin.jupyter.k2.scriptingSupport.KotlinNotebookScriptLibrariesProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- K1/K2 mode-specific services-->
        <projectService serviceInterface="com.intellij.kotlin.jupyter.core.scriptingSupport.ScriptingEntitiesConsistencyVerifier$Factory"
                serviceImplementation="com.intellij.kotlin.jupyter.k2.scriptingSupport.ScriptingEntitiesConsistencyVerifierFactoryK2"/>
        <projectService serviceInterface="com.intellij.kotlin.jupyter.core.scriptingSupport.CompiledClassifiersDefaultImportsEnhancer$Factory"
                        serviceImplementation="com.intellij.kotlin.jupyter.k2.scriptingSupport.imports.CompiledClassifiersDefaultImportsEnhancerFactoryK2"/>
        <projectService serviceInterface="com.intellij.kotlin.jupyter.core.ide.handlers.ScriptingSupportUpdater$Factory"
                        serviceImplementation="com.intellij.kotlin.jupyter.k2.scriptingSupport.updater.ScriptingSupportUpdaterFactoryK2"/>
        <projectService serviceInterface="com.intellij.kotlin.jupyter.core.scriptingSupport.definitions.KotlinNotebookScriptDefinitionsWrapper$Factory"
                        serviceImplementation="com.intellij.kotlin.jupyter.k2.scriptingSupport.definition.NotebookScriptDefinitionsWrapperFactoryK2"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij.kotlin.jupyter.core">
        <shadowingVisitorFactory implementation="com.intellij.kotlin.jupyter.k2.highlighting.ShadowingVisitorHandlerFactory"/>
        <sessionLibrariesFilter implementation="com.intellij.kotlin.jupyter.k2.projectModel.K2SessionLibrariesFilter"/>
    </extensions>
</idea-plugin>