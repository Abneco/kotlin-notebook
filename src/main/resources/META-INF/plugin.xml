<idea-plugin>
    <name>Kotlin for Jupyter</name>
    <id>org.jetbrains.plugins.kotlin.jupyter</id>
    <category>Template Languages</category>
    <vendor>JetBrains</vendor>
    <description>Kotlin support for Jupyter notebooks. Code insight, highlighting and so on.</description>

    <depends>org.jetbrains.kotlin</depends>
    <depends>Pythonid</depends>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Uncomment if you want to test something more easy than injecting into notebooks -->
        <!--<multiHostInjector implementation="org.jetbrains.kotlinx.jupyter.plugin.JupyterKotlinIntoJsonInjector"/>-->
        <multiHostInjector implementation="org.jetbrains.kotlinx.jupyter.plugin.JupyterKotlinIntoNotebookInjector"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <scriptDefinitionsProvider implementation="org.jetbrains.kotlinx.jupyter.plugin.JupyterDefProvider"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.notebooks.jupyter.actions">
        <jupyterAdditionalRunActionsHandler implementation="org.jetbrains.kotlinx.jupyter.plugin.JupyterKotlinRunActionsHandler"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.notebooks.jupyter">
        <jupyterAdditionalCellExecutionCallback implementation="org.jetbrains.kotlinx.jupyter.plugin.JupyterKotlinCellExecutionCallback"/>
    </extensions>
</idea-plugin>