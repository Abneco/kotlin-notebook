<idea-plugin package="com.intellij.kotlin.jupyter.k1">

    <dependencies>
        <plugin id="com.intellij.modules.kotlin.k1"/>
        <plugin id="org.jetbrains.plugins.kotlin.jupyter"/>
        <module name="intellij.jupyter.psi"/>
        <module name="intellij.jupyter.core"/>
        <module name="intellij.notebooks.jupyter.core"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.inlayProvider implementationClass="com.intellij.kotlin.jupyter.k1.codeinsight.hints.KotlinNotebookReferencesTypeHintsProvider" language="Jupyter"/>
        <codeInsight.inlayProvider implementationClass="com.intellij.kotlin.jupyter.k1.codeinsight.hints.NotebookLambdaTypeHintsProvider" language="Jupyter"/>
        <codeInsight.inlayProvider implementationClass="com.intellij.kotlin.jupyter.k1.codeinsight.hints.NotebookValuesHintProvider" language="Jupyter"/>
        <codeInsight.inlayProvider implementationClass="com.intellij.kotlin.jupyter.k1.codeinsight.hints.NotebookChainCallHintProvider" language="Jupyter"/>

        <highlightVisitor implementation="com.intellij.kotlin.jupyter.k1.highlighting.BeforeResolveHighlightingVisitorAdapter"/>
        <daemon.highlightInfoFilter implementation="com.intellij.kotlin.jupyter.k1.highlighting.KotlinNotebookHighlightingErrorFilter"/>

        <!-- K1/K2 mode-specific services -->
        <projectService serviceInterface="com.intellij.kotlin.jupyter.core.scriptingSupport.ScriptingEntitiesConsistencyVerifier$Factory"
                        serviceImplementation="com.intellij.kotlin.jupyter.k1.scriptingSupport.ScriptingEntitiesConsistencyVerifierFactoryK1"/>
        <projectService serviceInterface="com.intellij.kotlin.jupyter.core.scriptingSupport.CompiledClassifiersDefaultImportsEnhancer$Factory"
                        serviceImplementation="com.intellij.kotlin.jupyter.k1.scriptingSupport.CompiledClassifiersDefaultImportsEnhancerFactoryK1"/>
        <projectService serviceInterface="com.intellij.kotlin.jupyter.core.ide.handlers.ScriptingSupportUpdater$Factory"
                        serviceImplementation="com.intellij.kotlin.jupyter.k1.scriptingSupport.ScriptingSupportUpdaterFactoryK1"/>
        <projectService serviceInterface="com.intellij.kotlin.jupyter.core.scriptingSupport.definitions.KotlinNotebookScriptDefinitionsWrapper$Factory"
                        serviceImplementation="com.intellij.kotlin.jupyter.k1.scriptingSupport.definition.NotebookScriptDefinitionsWrapperFactoryK1"/>
    </extensions>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <idea.caches.resolve.resolveOptimizingOptionsProvider
                implementation="com.intellij.kotlin.jupyter.k1.resolve.KotlinNotebookOptimizingOptionsProvider"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij.kotlin.jupyter.core">
        <shadowingVisitorFactory implementation="com.intellij.kotlin.jupyter.k1.highlighting.ShadowingVisitorFactoryK1"/>
        <psiHostTypeHintsInvalidator implementation="com.intellij.kotlin.jupyter.k1.codeinsight.hints.K1PsiHostTypeHintsInvalidator"/>
    </extensions>
    <extensions defaultExtensionNs="org.jetbrains.kotlin.idea.compilerPlugin.kotlinxSerialization">
        <kotlinSerializationEnabledChecker
                implementation="com.intellij.kotlin.jupyter.k1.serialization.KotlinScriptingSerializationEnabledChecker"/>
    </extensions>
</idea-plugin>