{
  parserClass="com.intellij.kotlin.jupyter.core.psi.meta.JKTMetaParser"
  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="JKTMeta"
  psiImplClassSuffix="Impl"
  psiPackage="com.intellij.kotlin.jupyter.core.psi.meta"
  psiImplPackage="com.intellij.kotlin.jupyter.core.psi.meta.impl"

  elementTypeHolderClass="com.intellij.kotlin.jupyter.core.psi.meta.JKTMetaTypes"
  elementTypeClass="com.intellij.kotlin.jupyter.core.language.meta.psi.JKTMetaElementType"
  tokenTypeClass="com.intellij.kotlin.jupyter.core.language.meta.psi.JKTMetaTokenType"

  tokens = [
    ANY="regexp:.*"
    NEWLINE="regexp:\n"
  ]
}

root ::= file
file ::= marker_line? statements?

marker_line ::= CODE_MARKER ANY* newline_or_eof

statements ::= (empty_statements? command_statement empty_statements?) | repeatable_statements?

repeatable_statements ::= (empty_statements | magic_statement)+

command_statement ::= COMMAND_SIGN statement_id newline_or_eof {
    implements="com.intellij.kotlin.jupyter.core.language.meta.psi.JKTMetaCommandStatement"
}
magic_statement ::= MAGIC_SIGN statement_id args newline_or_eof {
    implements="com.intellij.kotlin.jupyter.core.language.meta.psi.JKTMetaMagicStatement"
}

statement_id ::= ID

empty_statements ::= NEWLINE+ <<eof>>?

newline_or_eof ::= NEWLINE | <<eof>>

args ::= arg*
arg ::= arg_token+
arg_token ::= ARG_SEP_TOKEN | ARG_VAL_TOKEN
