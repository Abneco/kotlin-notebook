<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.inlayProvider implementationClass="com.intellij.kotlin.jupyter.core.editor.codeInsight.KotlinNotebookReferencesTypeHintsProvider" language="Jupyter"/>
        <codeInsight.inlayProvider implementationClass="com.intellij.kotlin.jupyter.core.editor.codeInsight.NotebookLambdaTypeHintsProvider" language="Jupyter"/>
        <codeInsight.inlayProvider implementationClass="com.intellij.kotlin.jupyter.core.editor.codeInsight.NotebookValuesHintProvider" language="Jupyter"/>
        <codeInsight.inlayProvider implementationClass="com.intellij.kotlin.jupyter.core.editor.codeInsight.NotebookChainCallHintProvider" language="Jupyter"/>

        <highlightVisitor implementation="com.intellij.kotlin.jupyter.core.editor.highlighting.visitors.BeforeResolveHighlightingVisitorAdapter"/>
        <daemon.highlightInfoFilter implementation="com.intellij.kotlin.jupyter.core.editor.highlighting.service.KotlinNotebookHighlightingErrorFilter"/>
    </extensions>
</idea-plugin>