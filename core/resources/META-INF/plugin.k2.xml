<idea-plugin>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <scriptDefinitionsSource implementation="com.intellij.kotlin.jupyter.core.scriptingSupport.k2.KotlinNotebookScriptDefinitionsSource"/>
        <scriptDependenciesSource implementation="com.intellij.kotlin.jupyter.core.scriptingSupport.k2.NotebookScriptDependenciesSource"/>
        <kotlinInjectedFilesAnalysisProvider
                implementation="com.intellij.kotlin.jupyter.core.editor.highlighting.KotlinNotebookInjectedFilesAnalysisPromoter"
        />
        <scriptAdditionalIdeaDependenciesProvider implementation="com.intellij.kotlin.jupyter.core.scriptingSupport.k2.KotlinNotebookScriptLibrariesProvider"/>
    </extensions>
</idea-plugin>