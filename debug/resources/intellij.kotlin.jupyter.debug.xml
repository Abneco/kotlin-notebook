<idea-plugin visibility="internal">
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <dependencies>
      <module name="intellij.java.backend"/>
      <module name="intellij.jupyter.execution"/>
      <module name="intellij.java.debugger.impl"/>
      <module name="intellij.java.debugger.impl.shared"/>
      <module name="intellij.java.execution.impl"/>
      <module name="intellij.java.psi"/>
      <module name="intellij.jupyter.core"/>
      <module name="intellij.jupyter.psi"/>
      <module name="intellij.kotlin.base.analysis"/>
      <module name="intellij.kotlin.jupyter.core"/>
      <module name="intellij.kotlin.jvm.debugger.core"/>
      <module name="intellij.notebooks.jupyter.core"/>
      <module name="intellij.notebooks.ui"/>
      <module name="intellij.notebooks.visualization"/>
      <module name="kotlin.jvm-debugger.evaluation"/>
    </dependencies>
    <!-- endregion -->

    <extensionPoints>
        <extensionPoint qualifiedName="com.intellij.kotlin.jupyter.debug.jdiInvocationHandlerProvider"
                        interface="com.intellij.kotlin.jupyter.debug.proxy.JdiProxyInvocationHandlerProvider"
                        dynamic="true"/>
    </extensionPoints>


    <extensions defaultExtensionNs="com.intellij">
        <debugger.sourcePositionProvider
                implementation="com.intellij.kotlin.jupyter.debug.variables.context.NotebookFieldSourcePositionProvider" order="first"/>
        <debugger.hotSwapSourceFileFilterProvider
                implementation="com.intellij.kotlin.jupyter.debug.hotswap.NotebookHotSwapSourceFileFilterProvider"/>

        <registryKey key="kotlin.notebook.debug.enabled" defaultValue="true"
                     description="When enabled, establishing debug session with Kernel is possible"/>
        <registryKey key="kotlin.notebook.debug.cell.action.enabled" defaultValue="true"
                     description="When enabled, the 'Debug Cell' action is available in Kotlin Notebooks"/>
        <projectSettings service="com.intellij.kotlin.jupyter.debug.settings.KotlinNotebookDebugProjectOptionsProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij.kotlin.jupyter.debug">
        <jdiInvocationHandlerProvider
                implementation="com.intellij.kotlin.jupyter.debug.proxy.providers.NotebookInternalStateHandlersProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij.kotlin.jupyter.core">
        <notebookVariablesUiContentProvider
                implementation="com.intellij.kotlin.jupyter.debug.variables.presentation.NotebookVariablesUiContentProvider"/>
        <settings.settingsPanelBuilder
                implementation="com.intellij.kotlin.jupyter.debug.settings.ui.NotebookDebugFeaturesOptionsPanelBuilder"/>
        <moduleDependencyBehaviorRefiner
                implementation="com.intellij.kotlin.jupyter.debug.extensions.dependencies.NotebookDebugAwareDependenciesRefiner"/>
        <kernel.debugOptionsCustomizer
                implementation="com.intellij.kotlin.jupyter.debug.extensions.NotebookDebugVmOptionCustomizer"/>
    </extensions>

    <actions resource-bundle="messages/KotlinNotebookDebugBundle">
        <action id="KotlinNotebookDebugCellAction"
                class="com.intellij.kotlin.jupyter.debug.actions.KotlinNotebookDebugCellAction"
                icon="AllIcons.Actions.StartDebugger">
            <add-to-group group-id="JupyterDebugActions"/>
            <add-to-group group-id="JupyterEditorLeftToolbarActions" anchor="before"
                          relative-to-action="JupyterClearOutputsAction"/>/>
            <add-to-group group-id="Jupyter.AboveCodeCellAdditionalToolbar" anchor="first"/>
        </action>

        <group id="Notebook.XDebugger.StateValueGroup" popup="false">
            <reference ref="XDebugger.Inspect"/>
            <reference ref="XDebugger.CompareValueWithClipboard"/>
            <reference ref="XDebugger.CopyName"/>
            <reference ref="XDebugger.CopyValue"/>
            <separator/>
            <reference ref="XDebugger.JumpToSource"/>
            <reference ref="XDebugger.JumpToTypeSource"/>
            <separator/>
            <reference ref="Debugger.ViewText"/>
            <reference ref="Debugger.ViewAsGroup"/>
            <separator/>
            <reference ref="Debugger.CustomizeContextView"/>
        </group>
    </actions>
</idea-plugin>
