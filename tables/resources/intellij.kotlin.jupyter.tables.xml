<idea-plugin visibility="internal">
    <dependencies>
        <module name="intellij.jupyter.core"/>
        <module name="intellij.kotlin.jupyter.core"/>
        <module name="intellij.jupyter.tables"/>
        <module name="intellij.notebooks.dataframe"/>
        <module name="intellij.scientific.tables"/>
        <module name="intellij.notebooks.visualization"/>
        <module name="intellij.grid.core.impl"/>
        <module name="intellij.grid.impl"/>
        <module name="intellij.platform.searchEverywhere"/>
        <module name="intellij.notebooks.jupyter.core"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <registryKey key="kotlin.dataframe.swing.outputs.enabled" defaultValue="true"
                     description="When enabled, outputs of Kotlin Dataframe library will be rendered using JVM stack. Deprecated, use Kotlin Notebook options"/>

        <registryKey key="grid.tables.hierarchical.enabled" defaultValue="true"
                     description="When enabled, table output will support hierarchical columns."/>

        <registryKey key="ds.table.loading.max.chunk.size" defaultValue="10000"
                     description="The maximum chunk size for loading table rows"/>

        <registryKey key="grid.tables.hierarchical.additional.rows" defaultValue="1"
                     description="Additional space added to the bottom of hierarchical table component. Additional height calculated as 'value' times height of the row."/>

        <registryKey key="grid.tables.hierarchical.default.page.size" defaultValue="20"
                     description="Default number of rows displayed per page in hierarchical tables."/>
        
        <registryKey key="jupyter.notebook.varsCommandExecutor.timeout" defaultValue="600"
                     description="Custom timeout for JupyterVarsCommandExecutor. Increasing this could help prevent timeout exceptions when working with large datasets."/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.notebooks">
        <editor.outputs.notebookOutputDataKeyExtractor
                implementation="com.intellij.kotlin.jupyter.tables.KotlinDataframeOutputDataKeyExtractor" order="first"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij.scientific.tables">
        <tableDataProviderFactory
                implementation="com.intellij.kotlin.jupyter.tables.KotlinDataframeTableDataProvider"/>
        <tableDataTypeDetector
                implementation="com.intellij.kotlin.jupyter.tables.KotlinDataframeTableDataProvider"/>
    </extensions>
</idea-plugin>
