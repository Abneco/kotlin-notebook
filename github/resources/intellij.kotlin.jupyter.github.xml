<idea-plugin package="com.intellij.kotlin.jupyter.github">
    <dependencies>
        <module name="intellij.kotlin.jupyter.core"/>
        <plugin id="org.jetbrains.plugins.github"/>
    </dependencies>

    <actions resource-bundle="messages.KotlinNotebookBundle">
        <action id="KotlinNotebookGithubCreateGistAction"
                class="com.intellij.kotlin.jupyter.github.actions.KotlinNotebookGithubCreateGistAction"
                icon="AllIcons.Vcs.Vendors.Github">
            <add-to-group group-id="KotlinNotebookEditorActions" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
