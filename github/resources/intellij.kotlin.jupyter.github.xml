<idea-plugin package="com.intellij.kotlin.jupyter.github">
    <dependencies>
        <plugin id="org.jetbrains.plugins.kotlin.jupyter"/>
        <plugin id="org.jetbrains.plugins.github"/>
        <module name="intellij.jupyter.core"/>
        <module name="intellij.notebooks.jupyter.core"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <vcs.github.gistContentsCollector
                implementation="com.intellij.kotlin.jupyter.github.actions.KotlinNotebookGithubGistContentsCollector"
                order="before default"/>
    </extensions>

    <actions resource-bundle="messages.KotlinNotebookBundle">
        <action id="KotlinNotebookGithubCreateGistAction"
                class="com.intellij.kotlin.jupyter.github.actions.KotlinNotebookGithubCreateGistAction"
                icon="AllIcons.Vcs.Vendors.Github">
            <add-to-group group-id="KotlinNotebookEditorActions"
                          anchor="before" relative-to-action="KotlinNotebookSettingsActions"/>
        </action>
    </actions>
</idea-plugin>
