<idea-plugin package="org.jetbrains.kotlinx.jupyter.plugin.github">
    <dependencies>
        <plugin id="org.jetbrains.plugins.github"/>
    </dependencies>
    <actions resource-bundle="messages.KotlinNotebookBundle">
        <action id="KotlinNotebookGithubCreateGistAction"
                class="org.jetbrains.kotlinx.jupyter.plugin.github.actions.KotlinNotebookGithubCreateGistAction">
            <add-to-group group-id="KotlinNotebookEditorActions"
                          anchor="before" relative-to-action="KotlinNotebookSettingsActions"/>
        </action>
    </actions>
</idea-plugin>
