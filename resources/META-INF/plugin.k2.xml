<idea-plugin>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <scriptDefinitionsSource implementation="org.jetbrains.kotlinx.jupyter.plugin.scriptingSupport.k2.KotlinNotebookScriptDefinitionsSource"/>
        <scriptDependenciesSource implementation="org.jetbrains.kotlinx.jupyter.plugin.scriptingSupport.k2.NotebookScriptDependenciesSource"/>
        <kotlinInjectedFilesAnalysisProvider
                implementation="org.jetbrains.kotlinx.jupyter.plugin.editor.highlighting.KotlinNotebookInjectedFilesAnalysisPromoter"
        />
        <scriptAdditionalIdeaDependenciesProvider implementation="org.jetbrains.kotlinx.jupyter.plugin.scriptingSupport.k2.KotlinNotebookScriptLibrariesProvider"/>
    </extensions>
</idea-plugin>