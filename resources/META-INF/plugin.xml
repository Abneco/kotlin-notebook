<idea-plugin>
    <name>Kotlin Notebook</name>
    <id>org.jetbrains.plugins.kotlin.jupyter</id>
    <category>Tools Integration</category>
    <vendor>JetBrains</vendor>
    <description>
        <![CDATA[
            <p>Kotlin notebooks are interactive worksheets with rich outputs that allow you to explore and experiment with your
            Kotlin code without additional environment setup. The Kotlin Notebook plugin is a client for
            <a href="https://github.com/Kotlin/kotlin-jupyter">the Kotlin Jupyter kernel</a>
            that enables you to create and edit notebooks directly within IntelliJ IDEA.
            There are other clients that support Kotlin notebooks, including
            <a href="https://www.jetbrains.com/datalore/">Datalore</a>,
            <a href="https://jupyter.org/">Jupyter Notebook</a>,
            and <a href="https://jupyterlab.readthedocs.io/en/stable/#">JupyterLab</a>.</p>

            <p>The plugin comes with various features that are available in ordinary Kotlin files in the IDE,
            as well as additional Kotlin notebook-specific extensions. These include enhanced syntax highlighting,
            inlay hints, inspections, find usages, and refactorings, all of which help you write Kotlin code more efficiently.
            Many features are state-aware, meaning that finding usages or renaming
            will consider your current definitions and loaded libraries.</p>

            <p>Notebooks have two key distinguishing features compared to regular REPLs.
            Firstly, they allow you to save the entire session to a file, preserving both the code and the execution results.
            Secondly, the execution results can include more than just plain text;
            they can also encompass images in various formats, arbitrary HTML (including JavaScript and CSS),
            and even specifications for Swing outputs that are rendered directly within the IntelliJ IDE.
            To learn more about the diverse range of outputs and their rendering, please refer to
            <a href="https://github.com/Kotlin/kotlin-jupyter/tree/master/docs#rich-output">this link</a>.
            Additionally, there is <a href="https://github.com/Kotlin/kotlin-jupyter/tree/master/samples/outputs.ipynb">a sample notebook</a>,
            showcasing different types of outputs.</p>

            <p>With the Kotlin Notebook plugin, you can easily add binary dependencies from a remote
            Maven repository or a local one. For this, use
            <a href="https://github.com/Kotlin/kotlin-jupyter#dependencies-resolving"><code>@file:DependsOn</code> annotation or Gradle-like syntax</a>.
            <a href="https://github.com/Kotlin/kotlin-jupyter#list-of-supported-libraries">Some libraries</a> have special
            notebook integrations and can be imported with
            the <code>%use</code> line magic that comes with code insights to help you choose the correct library version.
            You can create a library descriptor or an integration for any library using
            <a href="https://github.com/Kotlin/kotlin-jupyter/blob/master/docs/libraries.md">this guide</a>.
            Integrations allow libraries to have rich outputs, add default imports,
            provide reflection-based code generation, and more.</p>

            <p>You can also use notebooks to explore the code in your current project – sources and
            binary dependencies can easily be added to the notebook context.
            To set this up or to adjust the Kotlin Notebook plugin appearance, use the following navigation in the IDE:</p>

            <pre><code>
            File -> Settings... -> Tools -> Kotlin Notebook
            </code></pre>

            <p>To learn more about using Kotlin notebooks, check out
            <a href="https://github.com/Kotlin/kotlin-jupyter">the Kotlin Jupyter kernel documentation</a>.
            If you have any questions or want to connect with other Kotlin developers who use notebooks,
            join the <a href="https://kotlinlang.slack.com/archives/C05333T208Y">#notebooks channel in the Kotlin Slack</a>.
            To file an issue, use <a href="https://youtrack.jetbrains.com/issues/KTNB">Kotlin Notebook YouTrack</a>. Stay tuned!</p>
        ]]>
    </description>

    <depends>org.jetbrains.kotlin</depends>
    <depends>Pythonid</depends>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.modules.ultimate</depends>

    <applicationListeners>
        <listener class="org.jetbrains.kotlinx.jupyter.plugin.editor.KotlinNotebookEditorColorsListener"
                  topic="com.intellij.openapi.editor.colors.EditorColorsListener"/>
    </applicationListeners>

    <projectListeners>
        <listener class="org.jetbrains.kotlinx.jupyter.plugin.JupyterKotlinRuntimeServiceListener"
                  topic="org.jetbrains.plugins.notebooks.jupyter.connections.execution.JupyterRuntimeService$Listener"/>
    </projectListeners>

    <extensionPoints>
        <extensionPoint qualifiedName="org.jetbrains.kotlinx.jupyter.plugin.session.extensions.kernelVmCommandCustomizer"
                        interface="org.jetbrains.kotlinx.jupyter.plugin.session.extensions.KernelVmCommandCustomizer"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <renameHandler implementation="org.jetbrains.kotlinx.jupyter.plugin.actions.refactor.KotlinNotebookPropertiesRenameHandler" />
        <scriptDefinitionsProvider implementation="org.jetbrains.kotlinx.jupyter.plugin.JupyterScriptDefinitionProvider"/>
        <idea.caches.resolve.resolveOptimizingOptionsProvider implementation="org.jetbrains.kotlinx.jupyter.plugin.resolve.KotlinNotebookOptimizingOptionsProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij.codeInsight.daemon.impl">
        <injectedLanguageHighlightingRangeReducer
                implementation="org.jetbrains.kotlinx.jupyter.plugin.file.highlighting.KotlinNotebookInjectedRangeReducer"
                id="kotlinNotebookRangeReducer"
                order="first"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <registryKey key="kotlin.notebook.disable.jupyter.core.actions" defaultValue="false"
                     description="Disable some of core Jupyter Notebook actions such as creation of Python Jupyter Notebook"/>
        <registryKey key="lets.plot.swing.outputs.enabled" defaultValue="false"
                         description="When enabled, outputs of LetsPlot plotting library in Kotlin Notebooks will be rendered using no-browser approach"/>

        <registryKey key="kotlin.dataframe.swing.outputs.enabled" defaultValue="false"
                     description="When enabled, outputs of Kotlin Dataframe library will be rendered using JVM stack."/>

        <registryKey key="grid.tables.hierarchical.enabled" defaultValue="false"
                     description="When enabled, table output will support hierarchical columns."/>

        <multiHostInjector implementation="org.jetbrains.kotlinx.jupyter.plugin.JupyterKotlinIntoCellsInjector"/>
        <editorNotificationProvider implementation="org.jetbrains.kotlinx.jupyter.plugin.notifications.NotebookLocationNotificationProvider"/>
        <fileIconPatcher implementation="org.jetbrains.kotlinx.jupyter.plugin.file.JupyterKotlinIconPatcher"/>
        <iconProvider implementation="org.jetbrains.kotlinx.jupyter.plugin.file.KotlinNotebookIconProvider"/>
        <highlightVisitor implementation="org.jetbrains.kotlinx.jupyter.plugin.editor.BeforeResolveHighlightingVisitorAdapter"/>
        <highlightVisitor implementation="org.jetbrains.kotlinx.jupyter.plugin.file.highlighting.KotlinNotebookBeforeHighlightingVisitor"
                          id="kotlinNotebookBeforeHighlightingVisitor"
                          order="first"/>
        <daemon.highlightInfoFilter implementation="org.jetbrains.kotlinx.jupyter.plugin.file.highlighting.KotlinNotebookHighlightingErrorFilter"/>
        <formatting.injectedOptions implementation="org.jetbrains.kotlinx.jupyter.plugin.editor.KotlinInjectedFormattingOptionsProvider"/>

        <fileType name="Jupyter Kotlin meta language"
                  language="JKTMeta"
                  extensions="juktm"
                  implementationClass="org.jetbrains.kotlinx.jupyter.plugin.lang.JKTMetaFileType"
                  fieldName="INSTANCE"/>

        <lang.parserDefinition language="JKTMeta" implementationClass="org.jetbrains.kotlinx.jupyter.plugin.lang.grammar.JKTMetaParserDefinition"/>

        <codeInsight.inlayProvider implementationClass="org.jetbrains.kotlinx.jupyter.plugin.codeinsight.KotlinNotebookReferencesTypeHintsProvider" language="Jupyter"/>
        <codeInsight.inlayProvider implementationClass="org.jetbrains.kotlinx.jupyter.plugin.codeinsight.NotebookLambdaTypeHintsProvider" language="Jupyter"/>
        <codeInsight.inlayProvider implementationClass="org.jetbrains.kotlinx.jupyter.plugin.codeinsight.NotebookValuesHintProvider" language="Jupyter"/>
        <codeInsight.inlayProvider implementationClass="org.jetbrains.kotlinx.jupyter.plugin.codeinsight.NotebookChainCallHintProvider" language="Jupyter"/>

        <liveTemplateContext contextId="KOTLIN_NOTEBOOK" implementation="org.jetbrains.kotlinx.jupyter.plugin.liveTemplates.KotlinNotebookTemplateContextType$Generic"/>
        <liveTemplateContext contextId="KOTLIN_NOTEBOOK_STATEMENT" baseContextId="KOTLIN_NOTEBOOK" implementation="org.jetbrains.kotlinx.jupyter.plugin.liveTemplates.KotlinNotebookTemplateContextType$Statement"/>
        <liveTemplateContext contextId="KOTLIN_NOTEBOOK_CLASS" baseContextId="KOTLIN_NOTEBOOK" implementation="org.jetbrains.kotlinx.jupyter.plugin.liveTemplates.KotlinNotebookTemplateContextType$Class"/>
        <liveTemplateContext contextId="KOTLIN_NOTEBOOK_EXPRESSION" baseContextId="KOTLIN_NOTEBOOK" implementation="org.jetbrains.kotlinx.jupyter.plugin.liveTemplates.KotlinNotebookTemplateContextType$Expression"/>
        <liveTemplateContext contextId="KOTLIN_NOTEBOOK_COMMENT" baseContextId="KOTLIN_NOTEBOOK" implementation="org.jetbrains.kotlinx.jupyter.plugin.liveTemplates.KotlinNotebookTemplateContextType$Comment"/>
        <liveTemplateContext contextId="KOTLIN_NOTEBOOK_OBJECT_DECLARATION" baseContextId="KOTLIN_NOTEBOOK" implementation="org.jetbrains.kotlinx.jupyter.plugin.liveTemplates.KotlinNotebookTemplateContextType$ObjectDeclaration"/>
        <liveTemplateContext contextId="KOTLIN_NOTEBOOK_META" baseContextId="KOTLIN_NOTEBOOK" implementation="org.jetbrains.kotlinx.jupyter.plugin.liveTemplates.KotlinNotebookTemplateContextType$Meta"/>

        <completion.contributor language="JKTMeta" id="JKTMetaBasic" implementationClass="org.jetbrains.kotlinx.jupyter.plugin.lang.codeInsight.JKTMetaCompletionContributor" />
        <!--<completion.contributor language="JKTMeta" implementationClass="org.jetbrains.kotlinx.jupyter.plugin.lang.codeInsight.KotlinMagicsRuntimeCompletionContributor" order="first"/>-->
        <annotator language="JKTMeta" implementationClass="org.jetbrains.kotlinx.jupyter.plugin.lang.codeInsight.JKTMetaAnnotator"/>
        <typedHandler implementation="org.jetbrains.kotlinx.jupyter.plugin.lang.codeInsight.JKTMetaTypedHandlerDelegate"/>
        <gotoDeclarationHandler implementation="org.jetbrains.kotlinx.jupyter.plugin.file.psi.NotebookGotoDeclarationProvider"/>
        <!--<searcher forClass="com.intellij.psi.search.searches.ReferencesSearch$SearchParameters"-->
        <!--          implementationClass="org.jetbrains.kotlinx.jupyter.plugin.file.psi.NotebookReferencesProvider"/>-->
        <renamePsiElementProcessor implementation="org.jetbrains.kotlinx.jupyter.plugin.actions.refactor.NotebookPropertyRenameProcessor"
                                   id="kotlinNotebookRenamePsiElementProcessor"
                                   order="first"/>
        <!--<renameHandler implementation= />-->
        <findUsagesHandlerFactory implementation="org.jetbrains.kotlinx.jupyter.plugin.file.psi.NotebookFindUsagesHandlerFactory"
                                  id="kotlinNotebookFindUsagesHandlerFactory"
                                  order="before kotlinFindUsagesHandlerFactory"/>
        <!--<lang.elementManipulator forClass="com.intellij.lang.elementManipulator" implementationClass="org.jetbrains.kotlinx.jupyter.plugin.file.psi.KotlinNotebookElementManipulator"/>-->
        <formattingService implementation="org.jetbrains.kotlinx.jupyter.plugin.actions.refactor.KotlinNotebookFileFormattingService"/>

        <psi.referenceContributor
                id="kotlinNotebookFilePathReferenceContributor"
                language="kotlin"
                implementation="org.jetbrains.kotlinx.jupyter.plugin.codeinsight.KotlinNotebookFilePathReferenceProvider"/>

        <projectConfigurable groupId="tools"
                             bundle="messages.JupyterKotlinBundle"
                             key="kotlin.jupyter.settings.title"
                             id="kotlinNotebook"
                             instance="org.jetbrains.kotlinx.jupyter.plugin.settings.KotlinNotebookConfigurable"/>

        <projectConfigurable groupId="tools"
                             bundle="messages.JupyterKotlinBundle"
                             key="kotlin.jupyter.settings.new.notebook.title"
                             id="kotlinNotebook.newNotebook"
                             parentId="kotlinNotebook"
                             instance="org.jetbrains.kotlinx.jupyter.plugin.settings.KotlinNotebookNewNotebookConfigurable"/>

        <notificationGroup
                id="Kotlin Notebook plugin updates"
                displayType="STICKY_BALLOON"
                bundle="messages.JupyterKotlinBundle"
                key="plugin.updater.notification.group"
        />
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin.scripting.idea">
        <listener implementation="org.jetbrains.kotlinx.jupyter.plugin.scripting.JupyterKtScriptChangeListener"/>
        <scriptingSupport implementation="org.jetbrains.kotlinx.jupyter.plugin.scripting.JupyterKtScriptingSupport"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin.idea.compilerPlugin.kotlinxSerialization">
        <kotlinSerializationEnabledChecker implementation="org.jetbrains.kotlinx.jupyter.plugin.serialization.KotlinScriptingSerializationEnabledChecker"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.notebooks">
        <jupyterLanguageBasedFileViewProviderChooser implementation="org.jetbrains.kotlinx.jupyter.plugin.JupyterKotlinFileViewProviderChooser"/>
        <editor.notebookEditorCreatedCallback implementation="org.jetbrains.kotlinx.jupyter.plugin.editor.KotlinNotebookEditorFactoryListener"/>
        <editor.outputs.notebookObjectOutputDataKeyExtractor implementation="org.jetbrains.kotlinx.jupyter.plugin.outputs.plots.PlotDataKeyExtractor"/>
        <editor.outputs.notebookOutputComponentFactory implementation="org.jetbrains.kotlinx.jupyter.plugin.outputs.plots.LetsPlotOutputComponentFactory"/>
        <editor.notebookEditorAppearanceProvider implementation="org.jetbrains.kotlinx.jupyter.plugin.editor.KotlinNotebookEditorAppearanceProvider"
                order="before JupyterNotebookEditorAppearanceProvider"/>
        <editor.outputs.notebookOutputDataKeyExtractor implementation="org.jetbrains.kotlinx.jupyter.plugin.outputs.tables.KotlinDataframeOutputDataKeyExtractor" order="first"/>
        <tables.externalPluginsTableDataProvider implementation="org.jetbrains.kotlinx.jupyter.plugin.outputs.tables.KotlinDataframeTableDataProvider"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.notebooks.jupyter">
        <jupyterCellExecutionCallbackFactory implementation="org.jetbrains.kotlinx.jupyter.plugin.JupyterKotlinCellExecutionCallbackFactory"/>
        <connections.execution.preExecutionSourceModifier implementation="org.jetbrains.kotlinx.jupyter.plugin.JupyterKotlinPreExecutionSourceModifier"/>
        <editorCustomizer implementation="org.jetbrains.kotlinx.jupyter.plugin.actions.KotlinJupyterEditorCustomizer"/>
        <jupyterActionPresentationModifier implementation="org.jetbrains.kotlinx.jupyter.plugin.actions.KotlinNotebookActionPresentationModifier"/>
        <connections.execution.core.jupyterServersFactory
                order="before default"
                implementation="org.jetbrains.kotlinx.jupyter.plugin.session.KotlinServersFactory"/>
        <connections.execution.core.managedJupyterServerRunner
                order="before default"
                implementation="org.jetbrains.kotlinx.jupyter.plugin.session.ManagedKotlinNotebookServerRunner"/>
        <connections.execution.notebookPathProvider implementation="org.jetbrains.kotlinx.jupyter.plugin.session.KotlinNotebookPathProvider"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlinx.jupyter.plugin">
        <session.extensions.kernelVmCommandCustomizer implementation="org.jetbrains.kotlinx.jupyter.plugin.extensions.spark.SparkKernelVmCommandCustomizer"/>
    </extensions>

    <actions resource-bundle="messages/JupyterKotlinBundle">
        <action id="CreateNewKotlinNotebook" class="org.jetbrains.kotlinx.jupyter.plugin.actions.KotlinNotebookCreateAction">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="JupyterCreateFileAction"/>
        </action>
        <action id="SelectKotlinNotebookModuleDependencies" class="org.jetbrains.kotlinx.jupyter.plugin.actions.KotlinNotebookSelectModulesAction"/>
        <action id="SelectKotlinNotebookProjectLibraries" class="org.jetbrains.kotlinx.jupyter.plugin.actions.KotlinNotebookSelectLibrariesAction"/>
        <action id="ShowKotlinNotebookPreferencesAction" class="org.jetbrains.kotlinx.jupyter.plugin.actions.KotlinNotebookShowPreferencesAction"
                icon="AllIcons.General.Settings"/>
        <action id="ToggleShowExecutionCount" class="org.jetbrains.kotlinx.jupyter.plugin.actions.KotlinNotebookToggleShowExecutionCountAction">
            <add-to-group group-id="JupyterEditorGutterPopupActions"/>
        </action>

        <group id="KotlinNotebookSettingsActions" popup="true" icon="AllIcons.General.GearPlain"
               class="org.jetbrains.kotlinx.jupyter.plugin.actions.KotlinNotebookSettingsActions">
            <reference id="SelectKotlinNotebookModuleDependencies"/>
            <reference id="SelectKotlinNotebookProjectLibraries"/>
            <separator/>
            <reference id="ShowKotlinNotebookPreferencesAction"/>
        </group>

        <group id="KotlinNotebookEditorActions">
            <separator/>
            <reference id="KotlinNotebookSettingsActions"/>
            <add-to-group group-id="JupyterEditorPopupActions"/>
            <add-to-group group-id="JupyterEditorLeftToolbarActions"/>
        </group>
    </actions>
</idea-plugin>
