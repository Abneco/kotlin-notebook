        <fileType name="JupyterKotlinFile"
                  language="Kotlin Notebook"
                  implementationClass="org.jetbrains.kotlinx.jupyter.plugin.language.JupyterKotlinFileType"
                  fieldName="INSTANCE"/>
        <lang.parserDefinition language="Kotlin Notebook" implementationClass="org.jetbrains.plugins.notebooks.jupyter.JupyterParserDefinition"/>
