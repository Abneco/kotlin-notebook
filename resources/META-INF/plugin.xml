<idea-plugin>
    <name>Kotlin Notebook</name>
    <id>org.jetbrains.plugins.kotlin.jupyter</id>
    <category>Tools Integration</category>
    <vendor>JetBrains</vendor>
    <description>Kotlin support for Jupyter notebooks. Code insight, highlighting and so on.</description>

    <depends>org.jetbrains.kotlin</depends>
    <depends>Pythonid</depends>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.modules.ultimate</depends>

    <extensions defaultExtensionNs="com.intellij">
        <multiHostInjector implementation="org.jetbrains.kotlinx.jupyter.plugin.JupyterKotlinIntoCellsInjector"/>
        <fileIconPatcher implementation="org.jetbrains.kotlinx.jupyter.plugin.file.JupyterKotlinIconPatcher"/>

        <fileType name="Jupyter Kotlin meta language"
                  language="JKTMeta"
                  extensions="juktm"
                  implementationClass="org.jetbrains.kotlinx.jupyter.plugin.lang.JKTMetaFileType"
                  fieldName="INSTANCE"/>

        <lang.parserDefinition language="JKTMeta" implementationClass="org.jetbrains.kotlinx.jupyter.plugin.lang.grammar.JKTMetaParserDefinition"/>

        <completion.contributor language="JKTMeta" implementationClass="org.jetbrains.kotlinx.jupyter.plugin.lang.codeInsight.JKTMetaCompletionContributor"/>
        <annotator language="JKTMeta" implementationClass="org.jetbrains.kotlinx.jupyter.plugin.lang.codeInsight.JKTMetaAnnotator"/>
        <typedHandler implementation="org.jetbrains.kotlinx.jupyter.plugin.lang.codeInsight.JKTMetaTypedHandlerDelegate"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <scriptDefinitionsProvider implementation="org.jetbrains.kotlinx.jupyter.plugin.JupyterScriptDefinitionProvider"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin.scripting.idea">
        <listener implementation="org.jetbrains.kotlinx.jupyter.plugin.scripting.JupyterKtScriptChangeListener"/>
        <scriptingSupport implementation="org.jetbrains.kotlinx.jupyter.plugin.scripting.JupyterKtScriptingSupport"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.notebooks">
        <jupyterLanguageBasedFileViewProviderChooser implementation="org.jetbrains.kotlinx.jupyter.plugin.JupyterKotlinFileViewProviderChooser"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.notebooks.jupyter">
        <jupyterCellExecutionCallbackFactory implementation="org.jetbrains.kotlinx.jupyter.plugin.JupyterKotlinCellExecutionCallbackFactory"/>
        <connections.execution.preExecutionSourceModifier implementation="org.jetbrains.kotlinx.jupyter.plugin.JupyterKotlinPreExecutionSourceModifier"/>
        <editorCustomizer implementation="org.jetbrains.kotlinx.jupyter.plugin.actions.KotlinJupyterEditorCustomizer"/>
        <jupyterActionPresentationModifier implementation="org.jetbrains.kotlinx.jupyter.plugin.actions.KotlinJupyterActionPresentationModifier"/>
    </extensions>

    <actions resource-bundle="messages/JupyterKotlinBundle">
        <action id="CreateNewKotlinNotebook" class="org.jetbrains.kotlinx.jupyter.plugin.actions.KotlinJupyterNotebookCreateAction">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="JupyterCreateFileAction"/>
        </action>
    </actions>
</idea-plugin>