        <liveTemplateContext contextId="KOTLIN_NOTEBOOK_CLASS" baseContextId="KOTLIN_NOTEBOOK" implementation="org.jetbrains.kotlinx.jupyter.plugin.editor.liveTemplates.KotlinNotebookTemplateContextType$Class"/>
        <liveTemplateContext contextId="KOTLIN_NOTEBOOK_EXPRESSION" baseContextId="KOTLIN_NOTEBOOK" implementation="org.jetbrains.kotlinx.jupyter.plugin.editor.liveTemplates.KotlinNotebookTemplateContextType$Expression"/>
        <liveTemplateContext contextId="KOTLIN_NOTEBOOK_COMMENT" baseContextId="KOTLIN_NOTEBOOK" implementation="org.jetbrains.kotlinx.jupyter.plugin.editor.liveTemplates.KotlinNotebookTemplateContextType$Comment"/>
        <liveTemplateContext contextId="KOTLIN_NOTEBOOK_OBJECT_DECLARATION" baseContextId="KOTLIN_NOTEBOOK" implementation="org.jetbrains.kotlinx.jupyter.plugin.editor.liveTemplates.KotlinNotebookTemplateContextType$ObjectDeclaration"/>
        <liveTemplateContext contextId="KOTLIN_NOTEBOOK_META" baseContextId="KOTLIN_NOTEBOOK" implementation="org.jetbrains.kotlinx.jupyter.plugin.editor.liveTemplates.KotlinNotebookTemplateContextType$Meta"/>

        <completion.contributor language="JKTMeta" id="JKTMetaBasic" implementationClass="org.jetbrains.kotlinx.jupyter.plugin.editor.codeInsight.metaLanguage.JKTMetaCompletionContributor" />
        <!--<completion.contributor language="JKTMeta" implementationClass="org.jetbrains.kotlinx.jupyter.plugin.lang.codeInsight.KotlinMagicsRuntimeCompletionContributor" order="first"/>-->
        <annotator language="JKTMeta" implementationClass="org.jetbrains.kotlinx.jupyter.plugin.editor.codeInsight.metaLanguage.JKTMetaAnnotator"/>
        <lang.commenter language="JKTMeta" implementationClass="org.jetbrains.kotlinx.jupyter.plugin.editor.codeInsight.metaLanguage.JKTMetaCommenter"/>
