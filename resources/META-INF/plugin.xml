        <action id="SelectKotlinNotebookProjectLibraries" class="org.jetbrains.kotlinx.jupyter.plugin.settings.actions.KotlinNotebookSelectLibrariesAction"/>
        <action id="ShowKotlinNotebookPreferencesAction" class="org.jetbrains.kotlinx.jupyter.plugin.settings.actions.KotlinNotebookShowPreferencesAction"
                icon="AllIcons.General.Settings"/>
        <action id="ToggleShowExecutionCount" class="org.jetbrains.kotlinx.jupyter.plugin.settings.actions.KotlinNotebookToggleShowExecutionCountAction">
